# This is a .env file template for development!
# See docs/deployment.md for production deployment information
ENVIRONMENT="development"
PORT=3000
SLACK_BOT_TOKEN="xoxb-..."
SLACK_USER_TOKEN="xoxp-..."
SLACK_SIGNING_SECRET="..."
SLACK_HEARTBEAT_CHANNEL="C..."
SLACK_TICKET_CHANNEL="C..."
SLACK_BTS_CHANNEL="C..."
SLACK_HELP_CHANNEL="C..."
SLACK_MAINTAINER_ID="U..."
FEEDBACK_CHANNEL_ID="C..."  # Optional: Channel to post feedback notifications
IGNORED_USERS=""  # Comma-separated Slack user IDs to ignore
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nephthys"
PROGRAM="help"  # a transcript name from nephthys/transcripts/transcripts/
BASE_URL="https://..."
APP_TITLE="helper heidi"
AI_API_KEY="sk-hc-v1-..."
PROMETHEUS_API_KEY="..."
AI_HELP_MIN_TICKETS=4  # "BETA ask ai" button shows for users with more than this many past tickets; -1 disables

HELPER_OAUTH_CLIENT_ID="..."  # optional: with the two below, enables helper OAuth so macros can delete trigger messages
HELPER_OAUTH_CLIENT_SECRET="..."
TOKEN_ENCRYPTION_KEY="..."  # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
